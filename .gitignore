# Secrets. The .env holds a live model API key and the kubeconfig holds a
# ServiceAccount token; neither may ever be committed.
.env
.env.*
!.env.example
*.kubeconfig
.incident-reader.kubeconfig

# Machine-local. mcp.json names an absolute interpreter path and cwd, so a
# committed copy is wrong for everyone but its author. The README carries the
# template instead.
.omp/

# Environments and build output
.venv/
build/
dist/
*.egg-info/

# Caches
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Agent scratch
evidence/
